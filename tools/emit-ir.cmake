cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED BUILD_DIR OR NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "Set BUILD_DIR and SOURCE_DIR, or use the project's ir build target.")
endif()

file(READ "${BUILD_DIR}/compile_commands.json" database)
string(JSON entry_count LENGTH "${database}")
set(generated_count 0)
if(entry_count EQUAL 0)
  message(FATAL_ERROR "The compilation database is empty.")
endif()
math(EXPR last_entry "${entry_count} - 1")

foreach(index RANGE 0 ${last_entry})
  string(JSON command GET "${database}" ${index} command)
  if(NOT command MATCHES "CMakeFiles[/\\]audio_engine[.]dir[/\\]")
    continue()
  endif()
  string(JSON source GET "${database}" ${index} file)
  string(JSON directory GET "${database}" ${index} directory)
  separate_arguments(arguments NATIVE_COMMAND "${command}")
  list(POP_FRONT arguments compiler)
  get_filename_component(compiler_name "${compiler}" NAME)
  set(cl_mode FALSE)
  if(compiler_name MATCHES "^clang-cl([.]exe)?$")
    set(cl_mode TRUE)
  elseif(NOT compiler_name MATCHES "^clang([+][+])?(-[0-9]+)?([.]exe)?$")
    message(FATAL_ERROR "IR generation requires a direct Clang compile command: ${compiler}")
  endif()

  file(RELATIVE_PATH relative_source "${SOURCE_DIR}" "${source}")
  if(relative_source MATCHES "^[.][.]/")
    message(FATAL_ERROR "Library source is outside the project: ${source}")
  endif()
  set(stem "${BUILD_DIR}/ir/${relative_source}")
  get_filename_component(output_directory "${stem}" DIRECTORY)
  file(MAKE_DIRECTORY "${output_directory}")

  set(filtered)
  set(skip_next FALSE)
  foreach(argument IN LISTS arguments)
    if(skip_next)
      set(skip_next FALSE)
    elseif(argument STREQUAL "-o" OR argument STREQUAL "/Fo" OR argument STREQUAL "/Fd")
      set(skip_next TRUE)
    elseif(argument MATCHES "^(/Fo|/Fd).+" OR argument MATCHES "^(/c|-c|/showIncludes)$")
      continue()
    elseif(NOT cl_mode AND argument MATCHES "^(-MF|-MT|-MQ)$")
      set(skip_next TRUE)
    elseif(NOT cl_mode AND argument MATCHES "^(-MD|-MMD|-MP)$")
      continue()
    else()
      list(APPEND filtered "${argument}")
    endif()
  endforeach()

  if(cl_mode)
    list(PREPEND filtered /clang:-S /clang:-emit-llvm /clang:-fsave-optimization-record
      "/clang:-foptimization-record-file=${stem}.opt.yaml" "/clang:-o${stem}.ll")
  else()
    list(PREPEND filtered -S -emit-llvm -fsave-optimization-record
      "-foptimization-record-file=${stem}.opt.yaml" -o "${stem}.ll")
  endif()

  execute_process(COMMAND "${compiler}" --version OUTPUT_VARIABLE version COMMAND_ERROR_IS_FATAL ANY)
  string(REPLACE ";" "\n" arguments_text "${filtered}")
  file(WRITE "${stem}.command.txt"
    "${version}\nWorking directory: ${directory}\nCompiler: ${compiler}\nArguments (one per line):\n${arguments_text}\n")
  execute_process(COMMAND "${compiler}" ${filtered}
    WORKING_DIRECTORY "${directory}"
    COMMAND_ERROR_IS_FATAL ANY
  )
  math(EXPR generated_count "${generated_count} + 1")
  message(STATUS "Generated ${stem}.ll and optimization remarks")
endforeach()

if(generated_count EQUAL 0)
  message(FATAL_ERROR "No audio_engine library compile commands were found.")
endif()
